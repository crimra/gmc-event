# Copie ce fichier en ".env" pour un test en local (STORAGE_BACKEND=local),
# ou renseigne ces mêmes variables comme "Secrets" dans les réglages de ton
# Hugging Face Space pour la mise en ligne (STORAGE_BACKEND=hf_dataset).

# Nom affiché sur les pages
EVENT_NAME="Mariage de ..."

# Mot de passe donné aux invités pour accéder à la galerie
EVENT_PASSWORD="change-moi"

# Mot de passe pour la page d'administration (upload des photos) — GARDE-LE SECRET
ADMIN_PASSWORD="change-moi-aussi"

# Clé aléatoire utilisée pour signer les cookies de session — mets une longue
# chaîne aléatoire différente pour chaque événement
SESSION_SECRET="change-moi-une-longue-chaine-aleatoire"

# Sensibilité de la reconnaissance faciale (0 à 1). Plus haut = moins de faux
# positifs mais risque de rater des photos. 0.38 est un bon point de départ.
MATCH_THRESHOLD=0.38

# Nombre maximum de photos acceptées
MAX_PHOTOS=2000

# --- Stockage ---
# "local"      : tout reste sur le disque du serveur (dev, ou auto-hébergement
#                sur une machine qui reste allumée)
# "hf_dataset" : les photos + l'index sont sauvegardés durablement dans un
#                dépôt Hugging Face "Dataset" privé et gratuit (recommandé
#                pour un déploiement sur Hugging Face Spaces)
STORAGE_BACKEND="local"

# Uniquement si STORAGE_BACKEND=hf_dataset :
# Token Hugging Face avec droit d'écriture (Settings > Access Tokens > New token, rôle "Write")
HF_TOKEN=""
# Dépôt dataset qui stockera les photos, au format "ton-pseudo/nom-du-depot"
# (créé automatiquement au premier démarrage s'il n'existe pas)
HF_DATASET_REPO=""
